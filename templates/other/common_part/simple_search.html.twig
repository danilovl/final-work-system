{% set inputGroupClass = inputGroupClass is defined ? inputGroupClass : '' %}

{{ form_start(searchForm, {'attr': {'class': 'float-end mail-search'}}) }}

<div class="input-group {{ inputGroupClass }}">
    {{ form_widget(searchForm.search, {'attr': {'class': 'form-control form-control-sm', 'placeholder': 'app.text.search_form' | trans}} ) }}
    <button type="submit"
            id="simple-search-button-action"
            class="btn btn-sm btn-primary"
    >
        {{ 'app.text.search' | trans }}
    </button>
</div>

{{ form_end(searchForm) }}

{% if enableClearSearch %}
    <a href="{{ clearSearchUrl }}"
       id="clear-simple-search-button-action"
       class="btn btn-danger btn-xs float-end"
    >
        <i class="fa-solid fa-xmark"></i>
    </a>
{% endif %}
