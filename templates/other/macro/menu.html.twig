{% macro renderMenu(menu, dropDownClass = 'nav side-menu', childdropDownClass = 'nav child_menu', itemClass = null) %}
    <ul class="{{ dropDownClass }}">
        {% for item in menu %}
            {{ _self.recursiveMenu(item, childdropDownClass, itemClass) }}
        {% endfor %}
    </ul>
{% endmacro %}

{% macro recursiveMenu(menuItem, dropDownClass, itemClass = null) %}
    {#  @let menuItem App\Application\Menu\MenuItem#}
    <li>
        <a {% if itemClass %}class="{{ itemClass }}" {% endif %}{% if menuItem.uri %}href="{{ menuItem.uri }}" {% endif %}>

            {% if menuItem.attribute('icon') is not empty %}
                <i class="{{ menuItem.attribute('icon') }}"></i>
            {% endif %}
            {{ menuItem.label }}

            {% if menuItem.children | length %}
                <span class="fa-solid fa-chevron-down"></span>
            {% endif %}
        </a>

        {% if menuItem.children | length %}
            <ul class="{{ dropDownClass }}">
                {% for child in menuItem.children %}
                    {{ _self.recursiveMenu(child, dropDownClass, itemClass) }}
                {% endfor %}
            </ul>
        {% endif %}
    </li>
{% endmacro %}
