{% extends 'base.html.twig' %}

{% block head %}
    <head>
        {% include 'other/analytics/analytics.html.twig' %}
        <meta charset="UTF-8">
        {% include 'other/script/theme.html.twig' %}
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="csrf-token" content="{{ csrf_token('ajax') }}">
        <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}"/>
        {% block title %} {{ seo_title() }} {% endblock %}
        {% block stylesheets %}
            {{ vite_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ vite_entry_script_tags('app') }}
        {% endblock %}
    </head>
{% endblock %}

{% block body %}
    <body class="nav-md">
    <div class="container body">
        <div class="main_container">

            {% block sidebar %}
                {% include 'other/page_section/sidebar.html.twig' %}
            {% endblock %}

            {% block topnav %}
                {% include 'other/page_section/topnav.html.twig' %}
            {% endblock %}

            {% block content %}{% endblock %}

            {% block footer %}
                {% include 'other/page_section/footer.html.twig' %}
            {% endblock %}

        </div>
    </div>

    <div class="modal fade"
         id="modalWindow"
         tabindex="-1"
         role="dialog"
         data-bs-keyboard="false"
         aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content"></div>
        </div>
    </div>

    <a href="#" id="back-to-top" title="Back to top">&uarr;</a>

    <div id='ajax-loader' style="position: fixed; left: 48%; top: 40%; display: none; z-index: 9999">
        <img src="{{ asset('build/images/loading.gif') }}" width="50px" height="50px" alt="loading"/>
    </div>

    <script type="application/json" id="frontend-config">{{ frontend_config() }}</script>

    {% if parameter_get('event_source.widget.top_nav.active') == true %}
        <div hidden
             data-controller="mercure-widget"
             data-mercure-widget-url-value="{{ mercure('unread-conversation-message-widget/' ~ app_user().id | hashids_encode) }}"
             data-mercure-widget-element-id-value="top-nav-unread-conversation-messages"></div>
        <div hidden
             data-controller="mercure-widget"
             data-mercure-widget-url-value="{{ mercure('unread-system-event-widget/' ~ app_user().id | hashids_encode) }}"
             data-mercure-widget-element-id-value="top-nav-unread-system-events"></div>
    {% endif %}

    {% block javascript %}{% endblock %}

    </body>
{% endblock %}
