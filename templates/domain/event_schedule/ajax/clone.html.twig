<div class="row ajax">
    <div class="col-md-12 col-sm-12 col-12">
        <div class="x_content">
            <div class="ibox-content">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-12">

                        {{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}
                        <div class="item form-group row">
                            {{ form_label(form.start, 'app.form.label.start', {'label_attr': {'class': 'col-form-label col-md-3 col-sm-3 col-12'}}) }}
                            <div class="col-md-6 col-sm-6 col-12 form-group has-feedback">
                                    <span class="fa-regular fa-calendar form-control-feedback left"
                                          aria-hidden="true">
                                    </span>
                                {{ form_widget(form.start, {
                                    'attr': {
                                        'data-controller': 'datetimepicker',
                                        'class': 'form-control has-feedback-left'
                                    }
                                }) }}
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-6 col-sm-6 col-12 offset-md-3">
                                <button class="btn btn-success"
                                        id="event_schedule_clone"
                                        data-controller="ajax-form">
                                    <i class="fa-solid fa-arrows-rotate fa-spin d-none"></i>
                                    {{ 'app.form.action.clonning' | trans }}
                                </button>
                            </div>
                        </div>
                        {{ form_end(form) }}

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
