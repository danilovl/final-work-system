{% extends 'layout.html.twig' %}

{% block content %}
    <div class="right_col" role="main">
        <div>
            <div class="clearfix"></div>
            <div class="row">
                <div class="col-lg-12">
                    <div class="ibox float-e-margins">
                        <div class="ibox-content text-center">
                            <h2>
                                <a href="{{ path('event_schedule_detail', { 'id': eventSchedule.id | hashids_encode }) }}">
                                    {{ eventSchedule }}
                                </a>
                            </h2>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 col-sm-12 col-12">
                    <div class="x_panel">
                        <div class="x_title">
                            <ul class="nav navbar-rul c panel_toolbox">
                                <li>
                                    <a class="collapse-link">
                                        <i class="fa-solid fa-chevron-up"></i>
                                    </a>
                                </li>
                            </ul>
                            <div class="clearfix"></div>
                        </div>
                        <div class="x_content">
                            <div class="ibox-content">
                                <div class="row">
                                    <div class="col-md-12 col-sm-12 col-12">

                                        {{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}
                                        <div class="item form-group row">
                                            {{ form_label(form.start, 'app.form.label.start', {'label_attr': {'class': 'col-form-label col-md-3 col-sm-3 col-12'}}) }}
                                            <div class="col-md-2 col-sm-2 col-12">
                                                <span class="fa-regular fa-calendar form-control-feedback left"
                                                      aria-hidden="true">
                                                </span>
                                                {{ form_widget(form.start, {
                                                    'attr': {
                                                        'data-controller': 'datetimepicker',
                                                        'class': 'form-control has-feedback-left'
                                                    }
                                                }) }}
                                            </div>
                                            {% if not form.start.vars.valid %}
                                                <div class="col-md-3 col-sm-3 col-12 red">
                                                    {{ form_errors(form.start) }}
                                                </div>
                                            {% endif %}
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-6 col-sm-6 col-12 offset-md-3">
                                                <input type="submit"
                                                       class="btn btn-success"
                                                       value="{{ 'app.form.action.clonning' | trans }}"/>
                                            </div>
                                        </div>
                                        {{ form_end(form) }}

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
