{% extends 'application/security/layout.html.twig' %}

{% block content %}
    <div class="login_wrapper">
        <div id="register" class="form">
            <section class="login_content">
                <p>
                    {{ 'app.text.reset_password_email_sent' | trans({'%hours%': tokenLifetime | date('g')}) }}
                </p>
                <p>
                    {{ 'app.text.reset_password_check_spam' | trans }}
                    <a href="{{ path('reset_password_forgot_request') }}">{{ 'app.text.reset_password_try_again' | trans }}</a>.
                </p>
            </section>
        </div>
    </div>
{% endblock %}
