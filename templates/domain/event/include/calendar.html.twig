<div class="row">
    <div class="col-md-6 col-sm-6 col-12">
        <div class="x_panel">
            <div class="x_title">
                <h2>
                    {{ 'app.text.appointment_calendar' | trans }}
                </h2>
                <ul class="nav navbar-right panel_toolbox">
                    <li>
                        <a class="collapse-link">
                            <i class="fa-solid fa-chevron-up"></i>
                        </a>
                    </li>
                </ul>
                <div class="clearfix"></div>
            </div>

            <div class="x_content">
                <div id="calendar-app" class="fc">
                    <calendar
                            locale="{{ app.request.locale }}"
                            endpoint-event-calendar-events-ajax="{{ path('event_detail_events_ajax',{'id' : event.id | hashids_encode}) }}"
                    >
                    </calendar>
                </div>
            </div>
        </div>
    </div>

    {% if event.address and event.address.existLocation %}
        <div class="col-md-6 col-sm-6 col-12">
            <div class="x_panel">
                <div class="x_title">
                    <h2>
                        {{ 'app.text.map' | trans }}
                    </h2>
                    <ul class="nav navbar-right panel_toolbox">
                        <li>
                            <a class="collapse-link">
                                <i class="fa-solid fa-chevron-up"></i>
                            </a>
                        </li>
                    </ul>
                    <div class="clearfix"></div>
                </div>
                <div class="x_content">
                    <div class="google-map" id="event-address-map" style="height: 400px"
                         data-controller="google-map"
                         data-google-map-target="map"
                         data-google-map-lat-value="{{ event.address.latitude }}"
                         data-google-map-lng-value="{{ event.address.longitude }}"
                    ></div>
                </div>
            </div>
        </div>
    {% endif %}
</div>