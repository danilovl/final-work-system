<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal">
        <span aria-hidden="true">×</span>
    </button>
</div>
<div class="row ajax">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_content">
            <div class="ibox-content">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12">

                        {{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}

                        <div class="item form-group">
                            {{ form_label(form.type,  'app.form.label.type' , {'label_attr': {'class': 'control-label col-md-3 col-sm-3 col-xs-12'}}) }}
                            <div class="col-md-9 col-sm-9 col-xs-12">
                                {{ form_widget(form.type, {
                                    'attr': {
                                        'data-controller': 'select2',
                                        'data-select2-width-value': '100%',
                                        'data-select2-dropdown-parent-value': '#modalWindow',
                                        'class': 'form-control'
                                    }
                                }) }}
                            </div>
                        </div>

                        <div class="item form-group">
                            {{ form_label(form.name,  'app.form.label.name' , {'label_attr': {'class': 'control-label col-md-3 col-sm-3 col-xs-12'}}) }}
                            <div class="col-md-9 col-sm-9 col-xs-12">
                                {{ form_widget(form.name, {'attr': {'class': 'form-control'}} ) }}
                            </div>
                        </div>

                        <div class="item form-group">
                            {{ form_label(form.address,  'app.form.label.appointment_address' , {'label_attr': {'class': 'control-label col-md-3 col-sm-3 col-xs-12'}}) }}
                            <div class="col-md-9 col-sm-9 col-xs-12">
                                {{ form_widget(form.address, {
                                    'attr': {
                                        'data-controller': 'select2',
                                        'data-select2-width-value': '100%',
                                        'data-select2-dropdown-parent-value': '#modalWindow',
                                        'class': 'form-control'
                                    }
                                }) }}
                            </div>
                        </div>

                        <div class="item form-group">
                            {{ form_label(form.participant,  'app.form.label.appointment_participant' , {'label_attr': {'class': 'control-label col-md-3 col-sm-3 col-xs-12'}}) }}
                            <div class="col-md-9 col-sm-9 col-xs-12">
                                {{ form_widget(form.participant, {
                                    'attr': {
                                        'data-controller': 'select2',
                                        'data-select2-width-value': '100%',
                                        'data-select2-dropdown-parent-value': '#modalWindow',
                                        'class': 'form-control'
                                    }
                                }) }}
                            </div>
                        </div>

                        <div class="item form-group">
                            {{ form_label(form.start, 'app.form.label.start', {'label_attr': {'class': 'control-label col-md-3 col-sm-3 col-xs-12'}}) }}

                            <div class="col-md-6 col-sm-6 col-xs-12 form-group has-feedback">
                                <i class="fa-regular fa-calendar form-control-feedback left"
                                   aria-hidden="true">
                                </i>
                                {{ form_widget(form.start, {
                                    'attr': {
                                        'data-controller': 'datetimepicker',
                                        'data-datetimepicker-format-value': 'YYYY-MM-DD HH:mm',
                                        'class': 'form-control has-feedback-left'
                                    }
                                }) }}
                            </div>
                        </div>

                        <div class="item form-group">
                            {{ form_label(form.end, 'app.form.label.end', {'label_attr': {'class': 'control-label col-md-3 col-sm-3 col-xs-12'}}) }}

                            <div class="col-md-6 col-sm-6 col-xs-12 form-group has-feedback">
                                <i class="fa-regular fa-calendar form-control-feedback left"
                                   aria-hidden="true">
                                </i>
                                {{ form_widget(form.end, {
                                    'attr': {
                                        'data-controller': 'datetimepicker',
                                        'data-datetimepicker-format-value': 'YYYY-MM-DD HH:mm',
                                        'class': 'form-control has-feedback-left'
                                    }
                                }) }}
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-12 col-sm-6 col-xs-12 col-md-offset-3">
                                <button class="btn btn-success"
                                        id="event_action"
                                        data-controller="ajax-form">
                                    <i class="fa-solid fa-arrows-rotate fa-spin hide"></i>
                                    {{ 'app.form.action.update' | trans }}
                                </button>
                                <button class="btn btn-primary"
                                        id="event_action_close"
                                        data-controller="ajax-form"
                                        data-ajax-form-close-value="true">
                                    <i class="fa-solid fa-arrows-rotate fa-spin hide"></i>
                                    {{ 'app.form.action.update_and_close' | trans }}
                                </button>
                            </div>
                        </div>

                        {{ form_end(form) }}

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

