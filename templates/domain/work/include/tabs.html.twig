<ul class="nav nav-tabs bar_tabs" role="tablist">
    {% if tasks is defined and tasks is not empty %}
        <li role="presentation">
            <a {% if activeTab == 'task' %} class="active" {% endif %}
               href="#tab-task"
               role="tab"
               data-bs-toggle="tab"
               aria-expanded="true">
                {{ 'app.text.task' | trans({'%count%': 2}) }}
            </a>
        </li>
    {% endif %}

    {% if versions is defined and versions is not empty %}
        <li role="presentation">
            <a {% if activeTab == 'version' %} class="active" {% endif %}
               href="#tab-version"
               role="tab"
               data-bs-toggle="tab"
               aria-expanded="false">
                {{ 'app.text.version' | trans({'%count%': 2}) }}
            </a>
        </li>
    {% endif %}

    {% if events is defined and events is not empty %}
        {% if is_work_role(work, app_user(), 'isAuthorSupervisor') %}
            <li role="presentation">
                <a {% if activeTab == 'event' %} class="active" {% endif %}
                   href="#tab-event"
                   role="tab"
                   data-bs-toggle="tab"
                   aria-expanded="false">
                    {{ 'app.text.appointment' | trans({'%count%': 2}) }}
                </a>
            </li>
        {% endif %}
    {% endif %}

    {% if messages is defined and messages is not empty %}
        <li role="presentation">
            <a {% if activeTab == 'message' %} class="active" {% endif %}
               href="#tab-message"
               role="tab"
               data-bs-toggle="tab"
               aria-expanded="false">
                {{ 'app.text.message' | trans({'%count%': 2}) }}
            </a>
        </li>
    {% endif %}
</ul>
