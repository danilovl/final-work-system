{% extends 'layout.html.twig' %}

{% block content %}
    <div data-controller="work-detail"
         data-work-detail-day-label-value="{{ 'app.calendar.day.day' | trans({'%count%': 2}) }}"
         data-work-detail-hour-label-value="{{ 'app.calendar.hour' | trans({'%count%': 2}) }}"
         data-work-detail-minute-label-value="{{ 'app.calendar.minute' | trans({'%count%': 2}) }}"
         data-work-detail-second-label-value="{{ 'app.calendar.second' | trans({'%count%': 2}) }}">
        <div class="top_nav hide"
             id="work-info-fixed"
             data-work-detail-target="fixedInfo">
            <div class="top-info-fixed">
                <h6>
                    {{ work.title }}, {{ work.deadline | date('Y-m-d') }} | {{ work.author }}
                </h6>
            </div>
        </div>
        <div class="right_col" role="main">
            <div>
                <div class="clearfix"></div>
                <div class="row">
                    <div class="col-md-9 col-sm-9 col-xs-12"
                         id="work-main-info"
                         data-work-detail-target="mainInfo">
                        {% include 'domain/work/include/work_info.html.twig' %}
                    </div>

                    <div class="col-md-3 col-sm-3 col-xs-12">
                        {% include 'domain/work/include/admin.html.twig' %}
                        {% include 'domain/work/include/profile.html.twig' %}
                    </div>
                    <div class="row">
                        <div class="col-md-12 col-sm-12 col-xs-12" id="tabs-area">
                            <div class="x_panel">
                                <div class="x_title">
                                    <ul class="nav navbar-right panel_toolbox">
                                        <li>
                                            <a class="collapse-link">
                                                <i class="fa-solid fa-chevron-up"></i>
                                            </a>
                                        </li>
                                    </ul>
                                    <div class="clearfix"></div>
                                </div>

                                <div class="x_content">
                                    {% include 'domain/work/include/btn_tab_panel.html.twig' %}

                                    <div role="tabpanel" data-example-id="togglable-tabs">
                                        {% include 'domain/work/include/tabs.html.twig' %}
                                        <div id="tab-content" class="tab-content">
                                            {% include 'domain/work/include/tab_task.html.twig' %}
                                            {% include 'domain/work/include/tab_version.html.twig' %}
                                            {% include 'domain/work/include/tab_event.html.twig' %}
                                            {% include 'domain/work/include/tab_conversation.html.twig' %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
