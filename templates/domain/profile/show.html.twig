{% extends 'layout.html.twig' %}

{% block content %}
    <div class="right_col" role="main">
        <section class="profile-hero">
            <div class="profile-hero-cover"></div>
            <div class="profile-hero-body">
                <img class="profile-hero-avatar"
                     src="{{ app_user() | profile_image }}"
                     alt="{{ app_user() }}">

                <div class="profile-hero-info">
                    <h1 class="profile-hero-name">{{ app_user() }}</h1>
                    <ul class="profile-hero-meta">
                        <li>
                            <i class="fa-regular fa-user"></i>{{ app_user().username }}
                        </li>
                        <li>
                            <i class="fa-regular fa-envelope"></i>{{ app_user().email }}
                        </li>
                        {% if app_user().skype is not empty %}
                            <li>
                                <i class="fa-brands fa-skype"></i>{{ app_user().skype }}
                            </li>
                        {% endif %}
                    </ul>
                </div>

                <div class="profile-hero-actions">
                    <a class="btn btn-primary" href="{{ path('profile_edit') }}">
                        <i class="fa-regular fa-pen-to-square"></i>
                        {{ 'app.menu.profile_edit' | trans }}
                    </a>
                    <a class="btn btn-default" href="{{ path('profile_change_password') }}">
                        <i class="fa-solid fa-key"></i>
                        {{ 'app.menu.profile_change_password' | trans }}
                    </a>
                    <a class="btn btn-default" href="{{ path('profile_change_image') }}">
                        <i class="fa-regular fa-image"></i>
                        {{ 'app.menu.profile_image_change' | trans }}
                    </a>
                </div>
            </div>
        </section>

        <div class="profile-grid">
            <section class="info-card">
                <h2 class="info-card-header">
                    <i class="fa-regular fa-address-card"></i>
                    {{ 'app.menu.contact_information' | trans }}
                </h2>
                <dl class="info-list">
                    <div class="info-list-row">
                        <dt>{{ 'app.form.label.email' | trans }}</dt>
                        <dd>{{ app_user().email }}</dd>
                    </div>
                    <div class="info-list-row">
                        <dt>{{ 'app.form.label.phone' | trans }}</dt>
                        <dd>{{ app_user().phone }}</dd>
                    </div>
                    {% if app_user().skype is not empty %}
                        <div class="info-list-row">
                            <dt>{{ 'app.form.label.skype' | trans }}</dt>
                            <dd>{{ app_user().skype }}</dd>
                        </div>
                    {% endif %}
                </dl>
            </section>

            <section class="info-card">
                <h2 class="info-card-header">
                    <i class="fa-regular fa-id-badge"></i>
                    {{ 'app.menu.personal_information' | trans }}
                </h2>
                <dl class="info-list">
                    <div class="info-list-row">
                        <dt>{{ 'app.form.label.username' | trans }}</dt>
                        <dd>{{ app_user().username }}</dd>
                    </div>
                    <div class="info-list-row">
                        <dt>{{ 'app.form.label.degree_before' | trans }}</dt>
                        <dd>{{ app_user().degreeBefore }}</dd>
                    </div>
                    <div class="info-list-row">
                        <dt>{{ 'app.form.label.first_name' | trans }}</dt>
                        <dd>{{ app_user().firstName }}</dd>
                    </div>
                    <div class="info-list-row">
                        <dt>{{ 'app.form.label.last_name' | trans }}</dt>
                        <dd>{{ app_user().lastName }}</dd>
                    </div>
                    <div class="info-list-row">
                        <dt>{{ 'app.form.label.degree_after' | trans }}</dt>
                        <dd>{{ app_user().degreeAfter }}</dd>
                    </div>
                </dl>
            </section>
        </div>

        <section class="info-card">
            <h2 class="info-card-header">
                <i class="fa-regular fa-envelope-open"></i>
                {{ 'app.menu.mail_template' | trans }}
            </h2>
            <dl class="info-list">
                <div class="info-list-row">
                    <dt>{{ 'app.form.label.message_greeting' | trans }}</dt>
                    <dd>{{ app_user().messageGreeting | sanitize_html('app.rich_text_sanitizer') }}</dd>
                </div>
                <div class="info-list-row">
                    <dt>{{ 'app.form.label.message_signature' | trans }}</dt>
                    <dd>{{ app_user().messageSignature | sanitize_html('app.rich_text_sanitizer') }}</dd>
                </div>
            </dl>
        </section>
    </div>
{% endblock content %}
