{% extends 'layout.html.twig' %}

{% block content %}
    <div class="right_col" role="main">
        <div class="settings-layout">
            {% include 'domain/profile/include/settings_nav.html.twig' with {
                'active': 'image'
            } %}

            <div class="settings-stack">
                <section class="info-card settings-content">
                    <h2 class="info-card-header">
                        <i class="fa-regular fa-image"></i>
                        {{ 'app.menu.profile_image_change' | trans }}
                    </h2>

                    <div class="settings-image">
                        <img class="settings-image-preview"
                             src="{{ app_user() | profile_image }}"
                             alt="{{ app_user() }}">

                        <div class="settings-image-form">
                            {{ form_start(form, {
                                'attr': {
                                    'class': 'settings-form'
                                }
                            }) }}
                            {% include 'domain/profile/include/form_field.html.twig' with {
                                'field': form.uploadMedia,
                                'label': 'app.form.label.file',
                                'attr': {
                                    'class': 'form-control'
                                }
                            } %}

                            <div class="settings-image-actions">
                                <button type="submit"
                                        id="upload-profile-image-button-action"
                                        class="btn btn-primary">
                                    <i class="fa-solid fa-upload"></i>
                                    {{ 'app.form.action.create' | trans }}
                                </button>
                            </div>
                            {{ form_end(form) }}

                            {% if app_user().profileImage is not null %}
                                {% set actionForm = action_form(path('profile_delete_image')) %}
                                {{ form_start(actionForm, {
                                    'attr': {
                                        'class': 'settings-image-delete'
                                    }
                                }) }}
                                    <button type="submit" class="btn btn-danger" id="delete-profile-image">
                                        <i class="fa-regular fa-trash-can"></i>
                                        {{ 'app.text.delete' | trans }}
                                    </button>
                                {{ form_end(actionForm) }}
                            {% endif %}
                        </div>
                    </div>
                </section>

                <section class="info-card settings-content">
                    <h2 class="info-card-header">
                        <i class="fa-solid fa-camera"></i>
                        {{ 'app.text.you_can_create_by_web_camera' | trans }}
                    </h2>
                    {% include('domain/profile/web_camera_image.html.twig') %}
                </section>
            </div>
        </div>
    </div>
{% endblock content %}
