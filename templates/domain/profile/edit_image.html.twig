{% extends 'layout.html.twig' %}

{% block content %}
    <div class="right_col" role="main">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-12">
                <div class="x_panel">
                    <div class="x_title">
                        <ul class="nav navbar-right panel_toolbox">
                            <li><a class="collapse-link"><i class="fa-solid fa-chevron-up"></i></a></li>
                        </ul>
                        <div class="clearfix"></div>
                    </div>
                    <div class="x_content">
                        <div class="col-md-3 col-sm-3 col-12 profile_left">
                            <div class="profile_img">
                                <div id="crop-avatar">
                                    <!-- Current avatar -->
                                    <img class="img-fluid avatar-view"
                                         src="{{ app_user() | profile_image }}"
                                         alt="Avatar"
                                         title="Change the avatar">
                                </div>
                            </div>
                            <h3>{{ app_user() }}</h3>
                            <ul class="list-unstyled user_data">
                                <li>
                                    <i class="fa-solid fa-user user-profile-icon"></i>
                                    {{ app_user().username }}
                                </li>
                                <li class="m-top-xs">
                                    <i class="fa-solid fa-at user-profile-icon"></i>
                                    {{ app_user().email }}
                                </li>
                                {% if  app_user().skype is not empty %}
                                    <li class="m-top-xs">
                                        <i class="fa-solid fa-skype user-profile-icon"></i>:
                                        {{ app_user().skype }}
                                    </li>
                                {% endif %}
                            </ul>
                            <ul class="list-unstyled user_data">
                                {% if app_user().profileImage is not null %}
                                    <li>
                                        {% set actionForm = action_form(path('profile_delete_image')) %}
                                        {{ form_start(actionForm, {
                                            'attr': {
                                                'style': 'display: inline'
                                            }
                                        }) }}
                                            <button type="submit" class="btn btn-danger" id="delete-profile-image">
                                                <i class="fa-regular fa-image"></i>
                                                {{ 'app.text.delete' | trans }}
                                            </button>
                                        {{ form_end(actionForm) }}
                                    </li>
                                {% endif %}
                                <li>
                                    <a class="btn btn-primary" href="{{ path('profile_show') }}">
                                        <i class="fa-solid fa-backward"></i>
                                        {{ 'app.menu.profile' | trans }}
                                    </a>
                                </li>
                                <li>
                                    <a class="btn btn-warning" href="{{ path('profile_change_password') }}">
                                        <i class="fa-regular fa-pen-to-square m-right-xs"></i>
                                        {{ 'app.menu.profile_change_password' | trans }}
                                    </a>
                                </li>
                            </ul>
                            <br/>
                        </div>

                        <div class="col-md-9 col-sm-9 col-12 mt-medium ">
                            <div class="row">
                                {{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}
                                <div class="item form-group row">
                                    {{ form_label(form.uploadMedia, 'app.form.label.file', {'label_attr': {'class': 'col-form-label col-md-3 col-sm-3 col-12'}}) }}
                                    <div class="col-md-6 col-sm-6 col-12">
                                        {{ form_widget(form.uploadMedia, {'attr': {'class': 'form-control'}}) }}
                                    </div>

                                    {% if not form.uploadMedia.vars.valid %}
                                        <div class="col-md-3 col-sm-3 col-12 red">
                                            {{ form_errors(form.uploadMedia) }}
                                        </div>
                                    {% endif %}
                                </div>

                                <div class="form-group row">
                                    <div class="col-md-6 col-sm-6 col-12 offset-md-3">
                                        <input type="submit"
                                               id="upload-profile-image-button-action"
                                               class="btn btn-success"
                                               value="{{ 'app.form.action.create' | trans }}"/>
                                    </div>
                                </div>
                                {{ form_end(form) }}
                            </div>

                            {% include('domain/profile/web_camera_image.html.twig') %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock content %}
