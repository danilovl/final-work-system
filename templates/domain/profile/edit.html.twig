{% extends 'layout.html.twig' %}

{% block content %}
    <div class="right_col" role="main">
        <div class="settings-layout">
            {% include 'domain/profile/include/settings_nav.html.twig' with {
                'active': 'edit'
            } %}

            <section class="info-card settings-content">
                <h2 class="info-card-header">
                    <i class="fa-regular fa-pen-to-square"></i>
                    {{ 'app.menu.profile_edit' | trans }}
                </h2>

                {{ form_start(form, {
                    'action': path('profile_edit'),
                    'attr': {
                        'data-controller': 'tinymce',
                        'class': 'settings-form'
                    }
                }) }}

                <ul class="nav nav-tabs settings-tabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a class="nav-link active"
                           href="#tab_content1"
                           id="home-tab"
                           role="tab"
                           data-bs-toggle="tab"
                           aria-selected="true">
                            <i class="fa-regular fa-address-card"></i>
                            {{ 'app.menu.contact_information' | trans }}
                        </a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link"
                           href="#tab_content2"
                           id="profile-tab"
                           role="tab"
                           data-bs-toggle="tab"
                           aria-selected="false">
                            <i class="fa-regular fa-id-badge"></i>
                            {{ 'app.menu.personal_information' | trans }}
                        </a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link"
                           href="#tab_content3"
                           id="profile-tab2"
                           role="tab"
                           data-bs-toggle="tab"
                           aria-selected="false">
                            <i class="fa-regular fa-envelope-open"></i>
                            {{ 'app.menu.mail_template' | trans }}
                        </a>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="tab-pane fade active show"
                         id="tab_content1"
                         role="tabpanel"
                         aria-labelledby="home-tab">
                        <div class="settings-form-body">
                            <div class="settings-field-row">
                                {% include 'domain/profile/include/form_field.html.twig' with {
                                    'field': form.email,
                                    'label': 'app.form.label.email',
                                    'attr': {
                                        'data-controller': 'input-mask',
                                        'class': 'form-control',
                                        'data-inputmask': "'alias' : 'email'"
                                    }
                                } %}
                                {% include 'domain/profile/include/form_field.html.twig' with {
                                    'field': form.phone,
                                    'label': 'app.form.label.phone',
                                    'attr': {
                                        'data-controller': 'input-mask',
                                        'class': 'form-control',
                                        'data-inputmask': "'mask' : '+(*{1,3}) *{1,15}'"
                                    }
                                } %}
                            </div>
                            <div class="settings-field-row">
                                {% include 'domain/profile/include/form_field.html.twig' with {
                                    'field': form.skype,
                                    'label': 'app.form.label.skype',
                                    'attr': {
                                        'class': 'form-control'
                                    }
                                } %}
                                {% include 'domain/profile/include/form_field.html.twig' with {
                                    'field': form.locale,
                                    'label': 'app.form.label.system_language',
                                    'attr': {
                                        'data-controller': 'select2',
                                        'data-select2-width-value': '100%',
                                        'class': 'form-control'
                                    }
                                } %}
                            </div>
                            <div class="settings-switch">
                                {{ form_widget(form.enabledEmailNotification, {
                                    'attr': {
                                        'data-controller': 'switch',
                                        'class': 'js-switch'
                                    }
                                }) }}
                                {{ form_label(form.enabledEmailNotification, 'app.form.label.email_motification', {
                                    'label_attr': {
                                        'class': 'form-label mb-0'
                                    }
                                }) }}
                                {% if not form.enabledEmailNotification.vars.valid %}
                                    <div class="invalid-feedback d-block">
                                        {{ form_errors(form.enabledEmailNotification) }}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade"
                         id="tab_content2"
                         role="tabpanel"
                         aria-labelledby="profile-tab">
                        <div class="settings-form-body">
                            {% include 'domain/profile/include/form_field.html.twig' with {
                                'field': form.username,
                                'label': 'app.form.label.username',
                                'attr': {
                                    'class': 'form-control'
                                }
                            } %}
                            <div class="settings-field-row">
                                {% include 'domain/profile/include/form_field.html.twig' with {
                                    'field': form.firstName,
                                    'label': 'app.form.label.first_name',
                                    'attr': {
                                        'class': 'form-control'
                                    }
                                } %}
                                {% include 'domain/profile/include/form_field.html.twig' with {
                                    'field': form.lastName,
                                    'label': 'app.form.label.last_name',
                                    'attr': {
                                        'class': 'form-control'
                                    }
                                } %}
                            </div>
                            <div class="settings-field-row">
                                {% include 'domain/profile/include/form_field.html.twig' with {
                                    'field': form.degreeBefore,
                                    'label': 'app.form.label.degree_before',
                                    'attr': {
                                        'class': 'form-control'
                                    }
                                } %}
                                {% include 'domain/profile/include/form_field.html.twig' with {
                                    'field': form.degreeAfter,
                                    'label': 'app.form.label.degree_after',
                                    'attr': {
                                        'class': 'form-control'
                                    }
                                } %}
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade"
                         id="tab_content3"
                         role="tabpanel"
                         aria-labelledby="profile-tab2">
                        <div class="settings-form-body settings-form-body-wide">
                            {% include 'domain/profile/include/form_field.html.twig' with {
                                'field': form.messageGreeting,
                                'label': 'app.form.label.message_greeting',
                                'attr': {
                                    'class': 'form-control'
                                }
                            } %}
                            {% include 'domain/profile/include/form_field.html.twig' with {
                                'field': form.messageSignature,
                                'label': 'app.form.label.message_signature',
                                'attr': {
                                    'class': 'form-control'
                                }
                            } %}
                        </div>
                    </div>
                </div>

                <div class="settings-form-footer">
                    <a class="btn btn-default" href="{{ path('profile_show') }}">
                        <i class="fa-solid fa-arrow-left"></i>
                        {{ 'app.menu.profile' | trans }}
                    </a>
                    <button type="submit"
                            id="user-edit-profile-button-action"
                            class="btn btn-primary">
                        <i class="fa-solid fa-check"></i>
                        {{ 'app.form.action.save' | trans }}
                    </button>
                </div>

                {{ form_end(form) }}
            </section>
        </div>
    </div>
{% endblock content %}
