{{ form_start(form, {
    'action': path('profile_change_password'),
    'attr': {
        'class': 'settings-form'
    }
}) }}
<div class="settings-form-body">
	<div class="settings-field">
		{{ form_label(form.current_password, 'app.form.label.current_password', {
			'label_attr': {
				'class': 'form-label'
			}
		}) }}
		{{ form_widget(form.current_password, {
			'attr': {
				'class': 'form-control',
				'autocomplete': 'current-password'
			}
		}) }}
		{% if not form.current_password.vars.valid %}
			<div class="invalid-feedback d-block">
				{{ form_errors(form.current_password) }}
			</div>
		{% endif %}
	</div>

	<div class="settings-field-row">
		<div class="settings-field">
			{{ form_label(form.plainPassword.first, 'app.form.label.new_password', {
				'label_attr': {
					'class': 'form-label'
				}
			}) }}
			{{ form_widget(form.plainPassword.first, {
				'attr': {
					'class': 'form-control',
					'autocomplete': 'new-password'
				}
			}) }}
			{% if not form.plainPassword.first.vars.valid %}
				<div class="invalid-feedback d-block">
					{{ form_errors(form.plainPassword.first) }}
				</div>
			{% endif %}
		</div>

		<div class="settings-field">
			{{ form_label(form.plainPassword.second, 'app.form.label.new_password_confirmation', {
				'label_attr': {
					'class': 'form-label'
				}
			}) }}
			{{ form_widget(form.plainPassword.second, {
				'attr': {
					'class': 'form-control',
					'autocomplete': 'new-password'
				}
			}) }}
			{% if not form.plainPassword.second.vars.valid %}
				<div class="invalid-feedback d-block">
					{{ form_errors(form.plainPassword.second) }}
				</div>
			{% endif %}
		</div>
	</div>
</div>

<div class="settings-form-footer">
	<a class="btn btn-default" href="{{ path('profile_show') }}">
		<i class="fa-solid fa-arrow-left"></i>
		{{ 'app.menu.profile' | trans }}
	</a>
	<button type="submit"
			id="user-change-password-button-action"
			class="btn btn-primary">
		<i class="fa-solid fa-check"></i>
		{{ 'app.form.action.save' | trans }}
	</button>
</div>
{{ form_end(form) }}
