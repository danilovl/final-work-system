<div class="web-camera"
     id="create-web-camera-image"
     data-controller="web-camera"
     data-id-web-camera-video="webCameraVideo"
     data-id-canvas="webCameraCanvas"
     data-url="{{ path('profile_create_image_web_camera_ajax') }}"
     data-id-button-capture="btnCapture"
     data-id-button-save="btnSave"
     data-max-show-width="400"
>
    <div class="web-camera-pane">
        <video id="webCameraVideo"
               class="profile-web-camera-area"
               playsinline
               autoplay
        >
        </video>
        <button type="button"
                class="btn btn-default"
                id="btnCapture"
                name="btnSave">
            <i class="fa-solid fa-camera"></i>
            {{ 'app.form.action.take_photo' | trans }}
        </button>
    </div>

    <div class="web-camera-pane">
        <canvas id="webCameraCanvas"></canvas>
        <button type="button"
                class="btn btn-primary"
                id="btnSave"
                name="btnSave">
            <i class="fa-solid fa-check"></i>
            {{ 'app.form.action.save' | trans }}
        </button>
    </div>
</div>
