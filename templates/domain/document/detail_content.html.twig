{% if document.mimeType.extension == 'zip' %}
    <div id="document-content-{{ document.id | hashids_encode }}"
         data-controller="archive-content"
         data-archive-content-url-value="{{ path('document_download', {
             'id': document.id | hashids_encode
         }) }}"
         data-archive-content-info-id-value="document-content-info-{{ document.id | hashids_encode }}"></div>
    <div id="document-content-info-{{ document.id | hashids_encode }}"></div>
{% elseif document.mimeType.extension != 'zip' and document.mimeType.extension != 'rar' %}
    <div id="iframe-document-content-{{ document.id | hashids_encode }}"></div>
{% endif %}
