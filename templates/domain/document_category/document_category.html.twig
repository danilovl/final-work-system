{% extends 'layout.html.twig' %}

{% block content %}
    <div class="right_col" role="main">
        <div>
            <div class="clearfix"></div>
            <div class="row">
                <div class="col-md-12 col-sm-12 col-12">
                    <div class="x_panel">
                        <div class="x_title">
                            <h2>
                                {{ title }}
                            </h2>
                            <ul class="nav navbar-rul c panel_toolbox">
                                <li>
                                    <a class="collapse-link">
                                        <i class="fa-solid fa-chevron-up"></i>
                                    </a>
                                </li>
                            </ul>
                            <div class="clearfix"></div>
                        </div>
                        <div class="x_content">
                            <div class="ibox-content">
                                <div class="row">
                                    <div class="col-md-12 col-sm-12 col-12">

                                        {{ form_start(form, {
                                            'attr': {
                                                'data-controller': 'tinymce',
                                                'class': 'form-horizontal'
                                            }
                                        }) }}
                                        <div class="item form-group row">
                                            {{ form_label(form.name,  'app.form.label.name' , {'label_attr': {'class': 'col-form-label col-md-3 col-sm-3 col-12'}}) }}
                                            <div class="col-md-6 col-sm-6 col-12">
                                                {{ form_widget(form.name, {'attr': {'class': 'form-control'}} ) }}
                                            </div>

                                            {% if not form.name.vars.valid %}
                                                <div class="col-md-3 col-sm-3 col-12 red">
                                                    {{ form_errors(form.name) }}
                                                </div>
                                            {% endif %}
                                        </div>
                                        <div class="item form-group row">
                                            {{ form_label(form.description,  'app.form.label.description' , {'label_attr': {'class': 'col-form-label col-md-3 col-sm-3 col-12'}}) }}
                                            <div class="col-md-6 col-sm-6 col-12">
                                                {{ form_widget(form.description, {'attr': {'class': 'form-control'}} ) }}
                                            </div>

                                            {% if not form.description.vars.valid %}
                                                <div class="col-md-3 col-sm-3 col-12 red">
                                                    {{ form_errors(form.description) }}
                                                </div>
                                            {% endif %}
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-6 col-sm-6 col-12 offset-md-3">
                                                <input type="submit"
                                                       class="btn btn-success"
                                                       value="{{ buttonActionTitle }}"/>
                                            </div>
                                        </div>
                                        {{ form_end(form) }}

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
