{% extends 'layout.html.twig' %}

{% block content %}
    <div class="right_col" role="main">
        <div>
            <div class="row">

                {% include('domain/conversation/include/menu_info.html.twig') %}

                <div class="col-lg-10">
                    <div class="mail-box">
                        <div class="mail-box-header">
                            <h2>
                                {{ 'app.text.new_message' | trans }}
                            </h2>
                        </div>
                        <div class="mail-box">
                            <div class="mail-body">

                                {{ form_start(form, {
                                    'attr': {
                                        'data-controller': 'tinymce',
                                        'class': 'form-horizontal'
                                    }
                                }) }}

                                {% if form.name is defined %}
                                    <div class="form-group row">
                                        {{ form_label(form.name, 'app.form.label.name' , {'label_attr': {'class': 'col-sm-2 col-form-label'}}) }}
                                        <div class="col-sm-10">
                                            {{ form_widget(form.name, {'attr': {'class': 'form-control'}} ) }}
                                            {% if not form.name.vars.valid %}
                                                <div class="col-md-12 col-sm-12 col-12 red">
                                                    {{ form_errors(form.name) }}
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endif %}

                                <div class="form-group row">
                                    {{ form_label(form.conversation, 'app.form.label.whom' , {'label_attr': {'class': 'col-sm-2 col-form-label'}}) }}
                                    <div class="col-sm-10">
                                        {{ form_widget(form.conversation, {
                                            'attr': {
                                                'data-controller': 'select2',
                                                'data-select2-optgroup-value': is_user_role(app_user(), 'isSupervisor') ? 'true' : 'false',
                                                'class': 'form-control'
                                            }
                                        }) }}
                                        {% if not form.conversation.vars.valid %}
                                            <div class="col-md-12 col-sm-12 col-12 red">
                                                {{ form_errors(form.conversation) }}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-sm-12">
                                        {{ form_widget(form.content, {'attr': {'class': 'form-control'}} ) }}
                                        {% if not form.content.vars.valid %}
                                            <div class="col-md-12 col-sm-12 col-12 red">
                                                {{ form_errors(form.content) }}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-sm-2">
                                        <input id="btn-conversation-create"
                                               type="submit"
                                               class="btn btn-success"
                                               value="{{ 'app.form.action.send' | trans }}"/>
                                    </div>
                                </div>
                                {{ form_end(form) }}

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
