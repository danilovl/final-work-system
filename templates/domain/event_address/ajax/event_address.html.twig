<div class="modal-header">
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="row ajax">
    <div class="col-md-12 col-sm-12 col-12">
        <div class="x_content">
            <div class="ibox-content">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-12">

                        {% set googleMapAttr = {
                            'data-controller': 'google-map tinymce',
                            'data-google-map-editable-value': 'true'
                        } %}
                        {% if eventAddress is defined and eventAddress.latitude is not empty and eventAddress.longitude is not empty %}
                            {% set googleMapAttr = googleMapAttr|merge({
                                'data-google-map-lat-value': eventAddress.latitude,
                                'data-google-map-lng-value': eventAddress.longitude
                            }) %}
                        {% endif %}
                        {{ form_start(form, {'attr': {'class': 'form-horizontal'}|merge(googleMapAttr)}) }}
                        <div class="item form-group row">
                            {{ form_label(form.name,  'app.form.label.name' , {'label_attr': {'class': 'col-form-label col-md-2 col-sm-2 col-12'}}) }}
                            <div class="col-md-10 col-sm-10 col-12">
                                {{ form_widget(form.name, {'attr': {'class': 'form-control'}} ) }}
                            </div>
                        </div>
                        <div class="item form-group row">
                            {{ form_label(form.description,  'app.form.label.description' , {'label_attr': {'class': 'col-form-label col-md-2 col-sm-2 col-12'}}) }}
                            <div class="col-md-10 col-sm-10 col-12">
                                {{ form_widget(form.description, {'attr': {'class': 'form-control'}} ) }}
                            </div>
                        </div>
                        <div class="item form-group row">
                            {{ form_label(form.street, 'app.form.label.street', {'label_attr': {'class': 'col-form-label col-md-2 col-sm-2  col-12'}}) }}
                            <div class="col-md-10 col-sm-10 col-12">
                                {{ form_widget(form.street, {
                                    'attr': {
                                        'class': 'form-control',
                                        'data-google-map-target': 'street'
                                    }
                                }) }}
                            </div>
                        </div>
                        <div class="item form-group row">
                            {{ form_label(form.latitude, 'app.form.label.latitude', {'label_attr': {'class': 'col-form-label col-md-2 col-sm-2  col-12'}}) }}
                            <div class="col-md-10 col-sm-10  col-12">
                                {{ form_widget(form.latitude, {
                                    'attr': {
                                        'class': 'form-control',
                                        'data-google-map-target': 'latitude'
                                    }
                                }) }}
                            </div>
                        </div>
                        <div class="item form-group row">
                            {{ form_label(form.longitude, 'app.form.label.longitude', {'label_attr': {'class': 'col-form-label col-md-2 col-sm-2 col-12'}}) }}
                            <div class="col-md-10 col-sm-10  col-12">
                                {{ form_widget(form.longitude, {
                                    'attr': {
                                        'class': 'form-control',
                                        'data-google-map-target': 'longitude'
                                    }
                                }) }}
                            </div>
                        </div>
                        <div class="item form-group row">
                            {{ form_label(form.skype, 'app.form.label.skype', {'label_attr': {'class': 'col-form-label col-md-2 col-sm-2 col-12'}}) }}
                            <div class="col-md-6 col-sm-6 col-12">
                                {{ form_widget(form.skype, {
                                    'attr': {
                                        'data-controller': 'switch',
                                        'class': 'form-control js-switch'
                                    }
                                }) }}
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-12 col-sm-12 col-12">
                                <div class="x_content">
                                    <div class="google-map" id="google-map-ajax" style="height: 400px" data-google-map-target="map"></div>
                                </div>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-12 col-sm-12 col-12 offset-md-2">
                                <button class="btn btn-success"
                                        id="event_address_action"
                                        data-controller="ajax-form">
                                    <i class="fa-solid fa-arrows-rotate fa-spin d-none"></i>
                                    {{ buttonActionTitle }}
                                </button>
                                <button class="btn btn-primary"
                                        id="event_address_action_close"
                                        data-controller="ajax-form"
                                        data-ajax-form-close-value="true">
                                    <i class="fa-solid fa-arrows-rotate fa-spin d-none"></i>
                                    {{ buttonActionCloseTitle }}
                                </button>
                            </div>
                        </div>
                        {{ form_end(form) }}

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

