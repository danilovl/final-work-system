{% extends 'layout.html.twig' %}

{% block content %}
    <div class="right_col" role="main">
        <div>
            {% if eventAddress is defined %}
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-12">
                        <div class="ibox float-e-margins">
                            <div class="ibox-content text-center">
                                <h2>
                                    {{ eventAddress.name }}
                                </h2>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 col-sm-6 col-12">
                        <div class="x_panel">
                            <div class="x_title">
                                <h2>
                                    {{ 'app.text.appointment_address' | trans }}
                                </h2>
                                {% include 'other/common_part/ajax_delete_modal.html.twig' with {
                                    'modalDataTarget': 'appointment-address',
                                    'modalDataTargetDeleteText': 'app.form.action.delete' | trans,
                                    'modalDataTargetId': eventAddress.id,
                                    'modalDataTargetName': eventAddress.name,
                                } %}
                                <ul class="nav navbar-right panel_toolbox">
                                    <li class="dropdown">
                                        <a href="#"
                                           data-bs-toggle="dropdown"
                                           data-bs-display="static"
                                           role="button"
                                           aria-expanded="false">
                                            <i class="fa-solid fa-wrench"></i>
                                        </a>
                                        <ul class="dropdown-menu" role="menu">
                                            <li>
                                                <a class="dropdown-item" href="{{ path('event_address_edit', { 'id': eventAddress.id | hashids_encode }) }}"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#modalWindow">
                                                    <i class="fa-regular fa-pen-to-square"></i>
                                                    {{ 'app.form.action.edit' | trans }}
                                                </a>
                                            </li>
                                            <li>
                                                {% include 'other/common_part/ajax_delete_button.html.twig' with {
                                                    'modalDataTargetDeleteClass': '',
                                                    'modalDataTarget': 'appointment-address',
                                                    'modalDataTargetDeleteText': 'app.form.action.delete' | trans,
                                                    'modalDataTargetId': eventAddress.id,
                                                    'modalDataTargetName': eventAddress.name,
                                                 } %}
                                            </li>
                                        </ul>
                                    </li>
                                    <li>
                                        <a class="collapse-link">
                                            <i class="fa-solid fa-chevron-up"></i>
                                        </a>
                                    </li>
                                </ul>
                                <div class="clearfix"></div>
                            </div>
                            <div class="x_content">
                                <dl class="dl-horizontal">
                                    <dt>
                                        {{ 'app.text.name' | trans }}
                                    </dt>
                                    <dd>
                                        {{ eventAddress.name }}
                                    </dd>

                                    {% if eventAddress.description %}
                                        <dt>
                                            {{ 'app.text.description' | trans }}
                                        </dt>
                                        <dd>
                                            {{ eventAddress.description | sanitize_html('app.rich_text_sanitizer') }}
                                        </dd>
                                    {% endif %}

                                    {% if eventAddress.street %}
                                        <dt>
                                            {{ 'app.text.street' | trans }}
                                        </dt>
                                        <dd>
                                            {{ eventAddress.street }}
                                        </dd>
                                    {% endif %}

                                </dl>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-6 col-12">
                        <div class="x_panel">
                            <div class="x_title">
                                <h2>
                                    {{ 'app.text.map' | trans }}
                                </h2>
                                <ul class="nav navbar-right panel_toolbox">
                                    <li>
                                        <a class="collapse-link">
                                            <i class="fa-solid fa-chevron-up"></i>
                                        </a>
                                    </li>
                                </ul>
                                <div class="clearfix"></div>
                            </div>

                            <div class="x_content">
                                <div class="google-map" id="google-map" style="height: 400px"
                                     data-controller="google-map"
                                     data-google-map-target="map"
                                     {% if eventAddress.latitude is not empty and eventAddress.longitude is not empty %}
                                     data-google-map-lat-value="{{ eventAddress.latitude }}"
                                     data-google-map-lng-value="{{ eventAddress.longitude }}"
                                     {% endif %}
                                ></div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

        </div>
    </div>
{% endblock %}

{% block javascript %}
    {% include 'other/script/google_map.twig' %}
{% endblock %}
