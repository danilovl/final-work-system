<!DOCTYPE html>
<html lang="en">
<head>
    {% include 'other/analytics/analytics.html.twig' %}
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    {% include 'other/script/theme.html.twig' %}
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}"/>
    {% block title %} {{ seo_title() }} {% endblock %}

    {% block stylesheets %}
        {{ vite_entry_link_tags('security') }}
    {% endblock %}

    {% block javascripts %}
        {{ vite_entry_script_tags('security') }}
    {% endblock %}
</head>
<body class="login">
<ul class="nav navbar-nav navbar-right">
    <li class="dropdown">
        <a href="javascript:"
           class="dropdown-toggle info-number"
           data-bs-toggle="dropdown"
           data-bs-display="static"
           aria-expanded="false">
            <i class="fa-solid fa-earth-americas"></i>
            <span class="visually-hidden">{{ 'app.menu.choose_language' | trans }}</span>
        </a>
        <ul class="dropdown-menu dropdown-usermenu" role="menu">
            {% for locale in locales() %}
                <li {% if app.request.locale == locale.code %}aria-checked="true"
                    {% else %}aria-checked="false"{% endif %} role="menuitem">
                    <a class="dropdown-item{% if app.request.locale == locale.code %} active{% endif %}" href="{{ path(app.request.attributes.get('_route', 'homepage'), app.request.attributes.get('_route_params', [])|merge({ _locale: locale.code })) }}">
                        {{ locale.name|capitalize }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </li>
</ul>
{% block content %}
{% endblock content %}
</body>
</html>
