{% extends 'application/security/layout.html.twig' %}

{% block content %}
    <div class="login_wrapper">
        <div class="animate form login_form">
            <section class="login_content">

                {% if error %}
                    <div id="error-login-message">{{ error.messageKey | trans(error.messageData, 'security') }}</div>
                {% endif %}

                {% for flashError in app.flashes('error') %}
                    <div class="alert alert-danger" role="alert">{{ flashError }}</div>
                {% endfor %}

                {% if app_user() %}
                    <div class="mb-3">
                        You are logged in as {{ app_user().username }}, <a href="{{ path('security_logout') }}">Logout</a>
                    </div>
                {% endif %}

                <form action="{{ path("security_login") }}" method="POST">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"/>

                    <div class="login-brand">
                        <span class="login-brand-mark">
                            <i class="fa-solid fa-book"></i>
                        </span>
                        <div>
                            <div class="login-brand-name">FinalWork System</div>
                            <div class="login-brand-subtitle">{{ 'app.system_name' | trans({}, 'messages') }}</div>
                        </div>
                    </div>

                    <h1>{{ 'app.form.label.login_form' | trans({}, 'messages') }}</h1>

                    <div class="form-floating">
                        <input type="text"
                               class="form-control"
                               placeholder="{{ 'app.form.label.username' | trans }}"
                               id="username"
                               name="_username"
                               value="{{ last_username }}"
                               autocomplete="username"
                               required="required"/>
                        <label for="username">{{ 'app.form.label.username' | trans }}</label>
                    </div>
                    <div class="form-floating">
                        <input type="password"
                               class="form-control"
                               placeholder="{{ 'app.form.label.password' | trans }}"
                               id="password"
                               name="_password"
                               autocomplete="current-password"
                               required="required"/>
                        <label for="password">{{ 'app.form.label.password' | trans }}</label>
                    </div>

                    <div class="login-actions">
                        <input class="btn btn-primary"
                               type="submit"
                               id="_submit"
                               name="_submit"
                               value="{{ 'app.form.action.login' | trans }}"/>

                        <a class="btn btn-default"
                           href="{{ path('reset_password_forgot_request') }}">
                            {{ 'app.form.action.reset_password' | trans }}
                        </a>
                    </div>

                    <div class="login-footer">
                        ©{{ "now" | date("Y") }} FinalWork System
                    </div>
                </form>
            </section>
        </div>
    </div>
{% endblock %}
